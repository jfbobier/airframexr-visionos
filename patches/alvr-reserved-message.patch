+/// AirFrameXR: the text of the last ReservedMessage event. Returns the length including the terminating zero; message_buffer can be null.
+#[no_mangle]
+pub extern "C" fn alvr_reserved_message(message_buffer: *mut c_char) -> u64 {
+    let cstring = CString::new(RESERVED_MESSAGE.lock().clone()).unwrap_or_default();
+    if !message_buffer.is_null() {
+        unsafe {
+            ptr::copy_nonoverlapping(
+                cstring.as_ptr(),
+                message_buffer,
+                cstring.as_bytes_with_nul().len(),
+            );
+        }
+    }
+
+    cstring.as_bytes_with_nul().len() as u64
+}
